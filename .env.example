# Open-vidIQ — copy to .env and fill in your own keys. Never commit .env.
# YouTube Data API v3 key (free, $0, 10,000 units/day):
# Google Cloud Console → APIs & Services → enable "YouTube Data API v3"
# → Credentials → Create API key.
YOUTUBE_API_KEY=

# Optional: Gemini API key (free tier, bring-your-own-key) for AI-polished
# titles. Without it, titles are generated locally from your keywords.
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
